<?xml version="1.0"?>
<robot name="auron_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-xacro files -->
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="robot_constants.xacro"/>
  <xacro:include filename="gazebo.xacro"/>
  <xacro:include filename="robot_control.xacro"/>

  <!-- ========================================== -->
  <!-- WORLD & BASE LINK                          -->
  <!-- ========================================== -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link: Flared pedestal base with cyan trim ring -->
  <link name="base_link">
    <!-- Visual: Flared white pedestal -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/base/base_pedestal.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- Visual: Lower cyan trim ring -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/base/base_accent_ring.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Upper collar cyan ring -->
    <visual>
      <origin xyz="0 0 0.118" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.102" length="0.006"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Simplified collision -->
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="8.0" r="0.18" h="0.12"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 1: Base Rotation (J1)                -->
  <!-- ========================================== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotation_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${j1_lower}" upper="${j1_upper}" effort="${j1_effort}" velocity="${j1_velocity}"/>
    <dynamics damping="${arm_damping}" friction="${arm_friction}"/>
  </joint>

  <!-- Base Rotation Link: Blue turret with gear-like hub & side details -->
  <link name="base_rotation_link">
    <!-- Visual: Central turret body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/base/base_turret.stl"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Cyan accent waist ring -->
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.012"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Left circular actuator cover -->
    <visual>
      <origin xyz="0 -0.095 0.08" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.02"/>
      </geometry>
      <material name="auron_dark_blue"/>
    </visual>
    <!-- Visual: Left cyan turbine hub -->
    <visual>
      <origin xyz="0 -0.106 0.08" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/shoulder/shoulder_turbine.stl" scale="0.7 0.7 0.7"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Right circular actuator cover -->
    <visual>
      <origin xyz="0 0.095 0.08" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.02"/>
      </geometry>
      <material name="auron_dark_blue"/>
    </visual>
    <!-- Visual: Right cyan turbine hub -->
    <visual>
      <origin xyz="0 0.106 0.08" rpy="-1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/shoulder/shoulder_turbine.stl" scale="0.7 0.7 0.7"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.11" length="0.16"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="4.5" r="0.11" h="0.16"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 2: Shoulder Pitch (J2)               -->
  <!-- ========================================== -->
  <joint name="joint_2" type="revolute">
    <parent link="base_rotation_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${j2_lower}" upper="${j2_upper}" effort="${j2_effort}" velocity="${j2_velocity}"/>
    <dynamics damping="${arm_damping}" friction="${arm_friction}"/>
  </joint>

  <!-- Shoulder Link: Circular gear housing with dual turbine faceplates -->
  <link name="shoulder_link">
    <!-- Visual: Geared circular housing -->
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/shoulder/shoulder_housing.stl"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Outer silver bolt ring left -->
    <visual>
      <origin xyz="0 -0.062 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.085" length="0.005"/>
      </geometry>
      <material name="auron_metal_silver"/>
    </visual>
    <!-- Visual: Left cyan turbine disc -->
    <visual>
      <origin xyz="0 -0.065 0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/shoulder/shoulder_turbine.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Outer silver bolt ring right -->
    <visual>
      <origin xyz="0 0.062 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.085" length="0.005"/>
      </geometry>
      <material name="auron_metal_silver"/>
    </visual>
    <!-- Visual: Right cyan turbine disc -->
    <visual>
      <origin xyz="0 0.065 0" rpy="-1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/shoulder/shoulder_turbine.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.15"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="5.5" r="0.12" h="0.15"/>
  </link>

  <!-- Connection to Upper Arm Link -->
  <joint name="upper_arm_joint" type="fixed">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Upper Arm Link: White shell with cyan accent collar -->
  <link name="upper_arm_link">
    <!-- Visual: Cylindrical white arm body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/upper_arm/upper_arm_body.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- Visual: Lower cyan accent ring -->
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/upper_arm/upper_arm_ring.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Upper cyan accent ring -->
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/upper_arm/upper_arm_ring.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.36"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="4.0" r="0.07" h="0.36"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 3: Elbow Pitch (J3)                  -->
  <!-- ========================================== -->
  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${j3_lower}" upper="${j3_upper}" effort="${j3_effort}" velocity="${j3_velocity}"/>
    <dynamics damping="${arm_damping}" friction="${arm_friction}"/>
  </joint>

  <!-- Elbow Link: Circular housing matching shoulder -->
  <link name="elbow_link">
    <!-- Visual: Circular geared elbow housing -->
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/elbow/elbow_housing.stl"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Left cyan turbine disc -->
    <visual>
      <origin xyz="0 -0.052 0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/elbow/elbow_turbine.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Visual: Right cyan turbine disc -->
    <visual>
      <origin xyz="0 0.052 0" rpy="-1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/elbow/elbow_turbine.stl"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.12"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="3.2" r="0.10" h="0.12"/>
  </link>

  <!-- Connection to Forearm Link -->
  <joint name="forearm_joint" type="fixed">
    <parent link="elbow_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Forearm Link: Sleek white forearm shell -->
  <link name="forearm_link">
    <!-- Visual: White forearm body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/forearm/forearm_body.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- Visual: Cyan accent stripe -->
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.015"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.32"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="2.8" r="0.055" h="0.32"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 4: Wrist Roll (J4)                   -->
  <!-- ========================================== -->
  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${j4_lower}" upper="${j4_upper}" effort="${j4_effort}" velocity="${j4_velocity}"/>
    <dynamics damping="${wrist_damping}" friction="${wrist_friction}"/>
  </joint>

  <!-- Wrist 1 Link: Compact blue/cyan cylindrical housing -->
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/wrist/wrist_1.stl"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Cyan accent ring -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.01"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="1.2" r="0.048" h="0.06"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 5: Wrist Pitch (J5)                  -->
  <!-- ========================================== -->
  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${j5_lower}" upper="${j5_upper}" effort="${j5_effort}" velocity="${j5_velocity}"/>
    <dynamics damping="${wrist_damping}" friction="${wrist_friction}"/>
  </joint>

  <!-- Wrist 2 Link: Compact circular pivot -->
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/wrist/wrist_2.stl"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Cyan pivot discs -->
    <visual>
      <origin xyz="0 -0.034 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.005"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <visual>
      <origin xyz="0 0.034 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.005"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="1.0" r="0.05" h="0.07"/>
  </link>

  <!-- ========================================== -->
  <!-- JOINT 6: Wrist Tool Roll (J6)              -->
  <!-- ========================================== -->
  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${j6_lower}" upper="${j6_upper}" effort="${j6_effort}" velocity="${j6_velocity}"/>
    <dynamics damping="${wrist_damping}" friction="${wrist_friction}"/>
  </joint>

  <!-- Wrist 3 Link: Metallic tool mounting flange -->
  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/wrist/wrist_3_flange.stl"/>
      </geometry>
      <material name="auron_metal_silver"/>
    </visual>
    <!-- Visual: Cyan bezel ring -->
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.044" length="0.006"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.044" length="0.025"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.6" r="0.044" h="0.025"/>
  </link>

  <!-- ========================================== -->
  <!-- TOOL0 FRAME                                -->
  <!-- ========================================== -->
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>

  <!-- ========================================== -->
  <!-- GRIPPER ASSEMBLY                           -->
  <!-- ========================================== -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Base Chassis -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/gripper/gripper_base.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- Visual: Blue actuator cylinder -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.035"/>
      </geometry>
      <material name="auron_blue"/>
    </visual>
    <!-- Visual: Cyan guide rail plate -->
    <visual>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.04 0.005"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.5" x="0.08" y="0.06" z="0.04"/>
  </link>

  <!-- Left Finger (Prismatic) -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0.015 0 0.038" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}" effort="${gripper_effort}" velocity="${gripper_velocity}"/>
    <dynamics damping="${gripper_damping}" friction="${gripper_friction}"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/gripper/gripper_finger.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- High-friction cyan inner pad -->
    <visual>
      <origin xyz="-0.005 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.012 0.03"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0.005 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.02 0.07"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.025" y="0.02" z="0.07"/>
  </link>

  <!-- Right Finger (Prismatic, symmetrical motion) -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="-0.015 0 0.038" rpy="0 0 3.14159265"/>
    <axis xyz="1 0 0"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}" effort="${gripper_effort}" velocity="${gripper_velocity}"/>
    <dynamics damping="${gripper_damping}" friction="${gripper_friction}"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auron_robot_description/meshes/gripper/gripper_finger.stl"/>
      </geometry>
      <material name="auron_white"/>
    </visual>
    <!-- High-friction cyan inner pad -->
    <visual>
      <origin xyz="-0.005 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.012 0.03"/>
      </geometry>
      <material name="auron_cyan"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0.005 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.02 0.07"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.025" y="0.02" z="0.07"/>
  </link>

  <!-- Gripper Center Tool Frame -->
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
  <link name="gripper_tcp"/>

  <!-- ========================================== -->
  <!-- CAMERA LINK & OPTICAL FRAME                -->
  <!-- ========================================== -->
  <!-- Eye-in-hand camera mounted on wrist_3_link -->
  <joint name="camera_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="camera_link"/>
    <origin xyz="0.045 0 0.02" rpy="0 -1.570796 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="auron_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.02" y="0.05" z="0.02"/>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <link name="camera_optical_frame"/>

</robot>
