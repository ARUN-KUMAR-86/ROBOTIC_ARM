<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- GAZEBO MATERIALS & VISUAL PROPERTIES       -->
  <!-- ========================================== -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.8 0.8 0.8 1.0</specular>
      </material>
    </visual>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="base_rotation_link">
    <visual>
      <material>
        <ambient>0.0 0.30 0.80 1.0</ambient>
        <diffuse>0.0 0.30 0.80 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="shoulder_link">
    <visual>
      <material>
        <ambient>0.0 0.30 0.80 1.0</ambient>
        <diffuse>0.0 0.30 0.80 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="upper_arm_link">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="elbow_link">
    <visual>
      <material>
        <ambient>0.0 0.30 0.80 1.0</ambient>
        <diffuse>0.0 0.30 0.80 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="forearm_link">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wrist_1_link">
    <visual>
      <material>
        <ambient>0.0 0.30 0.80 1.0</ambient>
        <diffuse>0.0 0.30 0.80 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wrist_2_link">
    <visual>
      <material>
        <ambient>0.0 0.30 0.80 1.0</ambient>
        <diffuse>0.0 0.30 0.80 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="wrist_3_link">
    <visual>
      <material>
        <ambient>0.82 0.84 0.86 1.0</ambient>
        <diffuse>0.82 0.84 0.86 1.0</diffuse>
        <specular>0.9 0.9 0.9 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="gripper_base">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- Gripper finger friction for firm physical grasping -->
  <gazebo reference="left_finger">
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="right_finger">
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- ========================================== -->
  <!-- CAMERA SENSOR (Simulated in Gazebo Sim)    -->
  <!-- ========================================== -->
  <gazebo reference="camera_link">
    <sensor name="robot_camera" type="camera">
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
    </sensor>
  </gazebo>

</robot>
