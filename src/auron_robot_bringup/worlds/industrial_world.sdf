<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="auron_industrial_world">
    <!-- Physics engine settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim plugins for Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Directional industrial overhead light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 1 4 0 0 0</pose>
      <diffuse>0.9 0.9 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Secondary fill light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-2 -2 3 0 0 0</pose>
      <diffuse>0.5 0.5 0.6 1</diffuse>
      <direction>0.5 0.5 -0.7</direction>
    </light>

    <!-- Factory Ground Plane with dark industrial floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.26 0.28 1</ambient>
            <diffuse>0.25 0.26 0.28 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Base Pedestal Stand -->
    <model name="robot_stand">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>
      <link name="stand_link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.18 0.22 1</ambient>
            <diffuse>0.15 0.18 0.22 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Industrial Worktable -->
    <model name="work_table">
      <static>true</static>
      <pose>0.50 0 0.15 0 0 0</pose>
      <link name="table_link">
        <!-- Table top -->
        <collision name="top_collision">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.90 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.90 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <!-- Table frame/legs -->
        <collision name="legs_collision">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.56 0.86 0.26</size>
            </box>
          </geometry>
        </collision>
        <visual name="legs_visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.56 0.86 0.26</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.15 0.35 1</ambient>
            <diffuse>0.08 0.15 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Demo Object 1: Red Cube -->
    <model name="red_cube">
      <pose>0.45 -0.15 0.32 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Demo Object 2: Blue Cube -->
    <model name="blue_cube">
      <pose>0.50 0.0 0.32 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Demo Object 3: Green Cylinder -->
    <model name="green_cylinder">
      <pose>0.45 0.15 0.325 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.018</radius>
              <length>0.045</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.018</radius>
              <length>0.045</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.85 0.2 1</ambient>
            <diffuse>0.1 0.85 0.2 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
