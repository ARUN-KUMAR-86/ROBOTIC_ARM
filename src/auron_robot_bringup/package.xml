<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auron_robot_bringup</name>
  <version>1.0.0</version>
  <description>Bringup, Gazebo worlds, master simulation launch files for Auron 6-DOF industrial robot arm</description>
  <maintainer email="info@auronrobotics.com">Auron Robotics Engineer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>auron_robot_description</exec_depend>
  <exec_depend>auron_robot_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
