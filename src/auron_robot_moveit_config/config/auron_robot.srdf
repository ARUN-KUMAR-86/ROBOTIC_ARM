<?xml version="1.0" encoding="UTF-8"?>
<robot name="auron_robot">

  <!-- ========================================== -->
  <!-- PLANNING GROUPS                            -->
  <!-- ========================================== -->
  <!-- Main 6-DOF Arm planning group -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
    <joint name="joint_1"/>
    <joint name="joint_2"/>
    <joint name="joint_3"/>
    <joint name="joint_4"/>
    <joint name="joint_5"/>
    <joint name="joint_6"/>
  </group>

  <!-- Gripper end-effector group -->
  <group name="gripper">
    <link name="gripper_base"/>
    <link name="left_finger"/>
    <link name="right_finger"/>
    <link name="gripper_tcp"/>
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <!-- ========================================== -->
  <!-- END-EFFECTOR DEFINITION                    -->
  <!-- ========================================== -->
  <end_effector name="auron_gripper" parent_link="tool0" group="gripper" parent_group="arm"/>

  <!-- ========================================== -->
  <!-- PREDEFINED GROUP STATES (POSES)            -->
  <!-- ========================================== -->
  <!-- Arm Home (straight vertical / nominal) -->
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="0.0"/>
    <joint name="joint_3" value="0.0"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Arm Ready (elbow up, tool facing forward) -->
  <group_state name="ready" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-0.6"/>
    <joint name="joint_3" value="1.2"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.9"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Arm Pick Pre-grasp (table inspection pose) -->
  <group_state name="pre_grasp" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-0.4"/>
    <joint name="joint_3" value="1.4"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.6"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Gripper Open State -->
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.035"/>
    <joint name="right_finger_joint" value="0.035"/>
  </group_state>

  <!-- Gripper Closed State -->
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
    <joint name="right_finger_joint" value="0.0"/>
  </group_state>

  <!-- ========================================== -->
  <!-- COLLISION MATRIX (SRDF)                    -->
  <!-- ========================================== -->
  <!-- Disable collisions between adjacent and physically non-colliding links -->
  <disable_collisions link1="base_link" link2="base_rotation_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="base_rotation_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="elbow_link" reason="Adjacent"/>
  <disable_collisions link1="elbow_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="right_finger" reason="Never"/>
  
  <!-- Non-adjacent pairs that cannot collide due to kinematic limits -->
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_rotation_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_rotation_link" link2="elbow_link" reason="Never"/>
  <disable_collisions link1="base_rotation_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="elbow_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="left_finger" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="right_finger" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="left_finger" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="right_finger" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="left_finger" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="right_finger" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="left_finger" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="right_finger" reason="Never"/>
  <disable_collisions link1="tool0" link2="left_finger" reason="Never"/>
  <disable_collisions link1="tool0" link2="right_finger" reason="Never"/>
  <disable_collisions link1="tool0" link2="camera_link" reason="Never"/>

</robot>
